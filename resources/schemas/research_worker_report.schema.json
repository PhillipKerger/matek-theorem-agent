{
  "$defs": {
    "SemanticFinding": {
      "additionalProperties": false,
      "description": "Mathematical content returned by a worker, independent of persistence.",
      "properties": {
        "depends_on": {
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "finding_type": {
          "$ref": "#/$defs/SemanticFindingType"
        },
        "next_mathematical_bottleneck": {
          "title": "Next Mathematical Bottleneck",
          "type": "string"
        },
        "relates_to": {
          "items": {
            "type": "string"
          },
          "title": "Relates To",
          "type": "array"
        },
        "statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Statement"
        },
        "status": {
          "$ref": "#/$defs/SemanticFindingStatus"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "what_was_established": {
          "title": "What Was Established",
          "type": "string"
        },
        "what_was_tried_and_did_not_work": {
          "title": "What Was Tried And Did Not Work",
          "type": "string"
        }
      },
      "required": [
        "finding_type",
        "title",
        "relates_to",
        "depends_on",
        "status",
        "statement",
        "what_was_established",
        "what_was_tried_and_did_not_work",
        "next_mathematical_bottleneck",
        "supporting_evidence"
      ],
      "title": "SemanticFinding",
      "type": "object"
    },
    "SemanticFindingStatus": {
      "enum": [
        "incomplete",
        "proposed",
        "blocked",
        "refuted"
      ],
      "title": "SemanticFindingStatus",
      "type": "string"
    },
    "SemanticFindingType": {
      "enum": [
        "definition",
        "theorem",
        "lemma",
        "partial_progress",
        "failed_approach",
        "counterexample",
        "computation",
        "source",
        "task"
      ],
      "title": "SemanticFindingType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The complete model-visible worker response.",
  "properties": {
    "assignment_title": {
      "title": "Assignment Title",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/SemanticFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "next_assignment": {
      "title": "Next Assignment",
      "type": "string"
    },
    "overall_progress": {
      "title": "Overall Progress",
      "type": "string"
    },
    "schema_version": {
      "const": 3,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "assignment_title",
    "findings",
    "overall_progress",
    "next_assignment"
  ],
  "title": "SemanticWorkerReport",
  "type": "object"
}
